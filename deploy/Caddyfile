# Libry（书阁）Web — Caddy 反代配置模板
# 把 kb.example.com 替换为你的域名（DNS A 记录指向服务器），Caddy 自动申请证书。
# 安装：sudo cp Caddyfile /etc/caddy/Caddyfile && sudo systemctl reload caddy

kb.example.com {
	reverse_proxy 127.0.0.1:8000

	# 安全响应头
	# CSP 的 frame-src 放行 Tauri 壳 origin（固定协议约定）：Web 应用经隐藏 iframe
	# 加载壳资产 bridge.html，把离线库镜像到壳 origin（客户端离线阅读器的数据面）。
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy same-origin
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-eval'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; frame-src http://tauri.localhost https://tauri.localhost tauri://localhost"
		-Server
	}

	# 访问日志（可选，配合 fail2ban）
	log {
		output file /var/log/caddy/libry.access.log
	}
}
